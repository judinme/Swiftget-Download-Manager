<Application
    x:Class="SwiftGet.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SwiftGet.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StatusToBrushConverter x:Key="StatusBrush" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:FileSizeConverter x:Key="FileSizeConverter" />
            <converters:SpeedConverter x:Key="SpeedConverter" />
            <converters:TimeRemainingConverter x:Key="TimeRemainingConverter" />
            <converters:PercentageConverter x:Key="PercentageConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
