<Window
    x:Class="SwiftGet.App.Views.DropBoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SwiftGet.App.ViewModels"
    Title="SwiftGet Drop Target">

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          DragLeave="RootGrid_DragLeave"
          Drop="RootGrid_Drop"
          Background="Transparent">

        <Border CornerRadius="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                Padding="8">
            <Grid>
                <!-- Close Button in top right -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="22" Height="22" Padding="0"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="Close Drop Target"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                </Button>

                <!-- Drop Target Center Content -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <FontIcon Glyph="&#xE896;" FontSize="28"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="SwiftGet Drop" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.LastItemAdded, Mode=OneWay}"
                               FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="100" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Badge for Dropped Count in bottom right -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="8" Padding="6,1" Margin="0,0,2,2">
                    <TextBlock Text="{x:Bind ViewModel.DroppedCount, Mode=OneWay}"
                               FontSize="10" FontWeight="Bold" Foreground="White" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
