<ContentDialog
    x:Class="SwiftGet.App.Views.AddUrlDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SwiftGet.App.ViewModels"
    Title="Enter new address to download"
    PrimaryButtonText="Download Now"
    SecondaryButtonText="Download Later"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Width="560">

    <Grid RowSpacing="12" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- URL Input -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="UrlTextBox"
                Header="Address (URL):"
                PlaceholderText="https://example.com/file.zip"
                Text="{x:Bind ViewModel.Url, Mode=TwoWay}"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Margin="8,26,0,0"
                Content="Probe"
                Command="{x:Bind ViewModel.ProbeCommand}"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Category & Queue -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Grid.Column="0"
                Header="Category:"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Categories}"
                SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />
            <ComboBox
                Grid.Column="1"
                Header="Queue:"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Queues}"
                SelectedItem="{x:Bind ViewModel.QueueName, Mode=TwoWay}" />
        </Grid>

        <!-- File Name & Save To -->
        <TextBox
            Grid.Row="2"
            Header="File Name:"
            PlaceholderText="my_download.zip"
            Text="{x:Bind ViewModel.FileName, Mode=TwoWay}" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                Header="Save To:"
                Text="{x:Bind ViewModel.SaveDirectory, Mode=TwoWay}" />
            <Button
                Grid.Column="1"
                Margin="8,26,0,0"
                Content="Browse..."
                Click="BrowseFolder_Click" />
        </Grid>

        <!-- Status & Space Information -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                FontSize="12"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                Text="{x:Bind ViewModel.FreeDiskSpace, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                FontSize="12"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Credentials Expander -->
        <Expander Grid.Row="5" Header="Authorization / Credentials (Optional)" HorizontalAlignment="Stretch">
            <Grid RowSpacing="8" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,4,0" Header="User:" Text="{x:Bind ViewModel.Username, Mode=TwoWay}" />
                <PasswordBox Grid.Column="1" Margin="4,0,0,0" Header="Password:" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
            </Grid>
        </Expander>
    </Grid>
</ContentDialog>
