<ContentDialog
    x:Class="SwiftGet.App.Views.CreateTorrentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SwiftGet.App.ViewModels"
    Title="Create BitTorrent (.torrent) File"
    PrimaryButtonText="Create Torrent"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Width="620">

    <Grid RowSpacing="12" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Source Path -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Header="Source File or Folder:" Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay}" PlaceholderText="C:\Files\MyContent" />
            <Button Grid.Column="1" Content="File..." Margin="8,26,0,0" Click="BrowseFile_Click" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Folder..." Margin="6,26,0,0" Click="BrowseFolder_Click" VerticalAlignment="Center" />
        </Grid>

        <!-- Destination .torrent Path -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Header="Save .torrent File To:" Text="{x:Bind ViewModel.SaveTorrentPath, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="Browse..." Margin="8,26,0,0" Click="BrowseSave_Click" VerticalAlignment="Center" />
        </Grid>

        <!-- Piece Size & Private Flag -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" Header="Piece Size:" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.PieceSizes}" SelectedIndex="{x:Bind ViewModel.SelectedPieceSizeIndex, Mode=TwoWay}" />
            <CheckBox Grid.Column="1" Margin="0,26,0,0" Content="Private torrent (disable DHT/PeX)" IsChecked="{x:Bind ViewModel.IsPrivateTorrent, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>

        <!-- Trackers -->
        <TextBox Grid.Row="3" Header="Trackers (one announce URL per line):" Text="{x:Bind ViewModel.TrackersText, Mode=TwoWay}" AcceptsReturn="True" Height="90" FontFamily="Consolas" FontSize="11" />

        <!-- Comment -->
        <TextBox Grid.Row="4" Header="Comment:" Text="{x:Bind ViewModel.Comment, Mode=TwoWay}" PlaceholderText="Optional torrent comment or description" />

        <!-- Progress and Status -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsCreating, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</ContentDialog>
