<ContentDialog
    x:Class="SwiftGet.App.Views.BatchDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SwiftGet.App.ViewModels"
    Title="Batch URL Download"
    PrimaryButtonText="Download Now"
    SecondaryButtonText="Add to Queue"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Width="640">

    <Grid RowSpacing="12" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Pattern Box -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Address Pattern (use [1-10] or [001-100] or [a-z]):"
                     Text="{x:Bind ViewModel.AddressPattern, Mode=TwoWay}"
                     PlaceholderText="https://example.com/files/img_[001-050].jpg"
                     VerticalAlignment="Center" />
            <Button Grid.Column="1" Margin="8,26,0,0" Content="Preview"
                    Command="{x:Bind ViewModel.UpdatePreviewCommand}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Generated URL List Preview -->
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.GeneratedCountSummary, Mode=OneWay}"
                       FontSize="12" FontWeight="SemiBold" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Height="180">
                <ListView ItemsSource="{x:Bind ViewModel.GeneratedUrls}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>

        <!-- Save Directory & Queue -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Header="Save To Directory:"
                     Text="{x:Bind ViewModel.SaveDirectory, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Header="Queue:" HorizontalAlignment="Stretch"
                      SelectedItem="{x:Bind ViewModel.QueueName, Mode=TwoWay}">
                <ComboBoxItem Content="default" IsSelected="True" />
                <ComboBoxItem Content="sync" />
            </ComboBox>
        </Grid>

        <!-- Status Bar -->
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</ContentDialog>
