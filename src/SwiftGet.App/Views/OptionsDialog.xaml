<ContentDialog
    x:Class="SwiftGet.App.Views.OptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SwiftGet.App.ViewModels"
    Title="Options &amp; Configuration"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Width="680"
    Height="560">

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Tab Control -->
        <TabView Grid.Row="0" IsAddTabButtonVisible="False" TabWidthMode="Equal">
            <!-- TAB 1: Categories -->
            <TabViewItem Header="Categories" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Category:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Categories}"
                                      SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                                      DisplayMemberPath="Name" />
                        </Grid>

                        <TextBox Header="Save To Directory:"
                                 Text="{x:Bind ViewModel.CategoryTargetDirectory, Mode=TwoWay}"
                                 PlaceholderText="%USERPROFILE%\Downloads\..." />

                        <TextBox Header="File Extensions (space-separated):"
                                 Text="{x:Bind ViewModel.CategoryFileExtensions, Mode=TwoWay}"
                                 PlaceholderText=".zip .rar .7z .tar .gz" />

                        <Button Content="Apply to Category" Command="{x:Bind ViewModel.SaveCategoryCommand}" HorizontalAlignment="Right" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- TAB 2: Antivirus -->
            <TabViewItem Header="Antivirus" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel Spacing="12">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="10">
                                <CheckBox Content="Scan completed downloads for viruses"
                                          IsChecked="{x:Bind ViewModel.AntivirusEnabled, Mode=TwoWay}"
                                          FontWeight="SemiBold" />

                                <RadioButton GroupName="AvGroup" Content="Use Windows Defender (MpCmdRun.exe)"
                                             IsChecked="{x:Bind ViewModel.UseWindowsDefender, Mode=TwoWay}"
                                             IsEnabled="{x:Bind ViewModel.AntivirusEnabled, Mode=OneWay}"
                                             Margin="24,0,0,0" />

                                <RadioButton GroupName="AvGroup" Content="Use custom antivirus scanner executable"
                                             IsEnabled="{x:Bind ViewModel.AntivirusEnabled, Mode=OneWay}"
                                             Margin="24,0,0,0" />

                                <TextBox Header="Scanner Executable Path:"
                                         Text="{x:Bind ViewModel.CustomScannerPath, Mode=TwoWay}"
                                         IsEnabled="{x:Bind ViewModel.AntivirusEnabled, Mode=OneWay}"
                                         PlaceholderText="C:\Program Files\Antivirus\scan.exe"
                                         Margin="24,0,0,0" />

                                <TextBox Header="Scanner Arguments Pattern:"
                                         Text="{x:Bind ViewModel.CustomScannerArguments, Mode=TwoWay}"
                                         IsEnabled="{x:Bind ViewModel.AntivirusEnabled, Mode=OneWay}"
                                         PlaceholderText="&quot;{path}&quot;"
                                         Margin="24,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- TAB 3: Sounds -->
            <TabViewItem Header="Sounds" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel Spacing="12">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Sound Events:" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox Grid.Row="0" Grid.Column="0" Content="Download complete"
                                              IsChecked="{x:Bind ViewModel.SoundDownloadCompleteEnabled, Mode=TwoWay}" />
                                    <Button Grid.Row="0" Grid.Column="1" Content="Test"
                                            Command="{x:Bind ViewModel.TestSoundCommand}" CommandParameter="complete" />

                                    <CheckBox Grid.Row="1" Grid.Column="0" Content="Download error"
                                              IsChecked="{x:Bind ViewModel.SoundDownloadErrorEnabled, Mode=TwoWay}" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="Test"
                                            Command="{x:Bind ViewModel.TestSoundCommand}" CommandParameter="error" />

                                    <CheckBox Grid.Row="2" Grid.Column="0" Content="Queue complete"
                                              IsChecked="{x:Bind ViewModel.SoundQueueCompleteEnabled, Mode=TwoWay}" />
                                    <Button Grid.Row="2" Grid.Column="1" Content="Test"
                                            Command="{x:Bind ViewModel.TestSoundCommand}" CommandParameter="queue" />
                                </Grid>

                                <TextBox Header="Custom WAV Audio Path (optional):"
                                         Text="{x:Bind ViewModel.CustomSoundPath, Mode=TwoWay}"
                                         PlaceholderText="C:\Windows\Media\tada.wav"
                                         Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- TAB 4: Connection -->
            <TabViewItem Header="Connection" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel Spacing="12">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Connection &amp; Speed Limits:" FontWeight="SemiBold" />
                                <NumberBox Header="Default Max Connections per Download:"
                                           Value="{x:Bind ViewModel.MaxConnections, Mode=TwoWay}"
                                           Minimum="1" Maximum="32" SmallChange="1" SpinButtonPlacementMode="Inline" />

                                <NumberBox Header="Maximum Concurrent Downloads:"
                                           Value="{x:Bind ViewModel.MaxConcurrentDownloads, Mode=TwoWay}"
                                           Minimum="1" Maximum="10" SmallChange="1" SpinButtonPlacementMode="Inline" />

                                <CheckBox Content="Show progress dialog for streaming media (YouTube) downloads"
                                          IsChecked="{x:Bind ViewModel.ShowProgressWindowForMediaDownloads, Mode=TwoWay}" />

                                <CheckBox Content="Delete partial files when download is cancelled"
                                          IsChecked="{x:Bind ViewModel.DeletePartialFilesOnCancel, Mode=TwoWay}" />

                                <CheckBox Content="Enable Global Speed Limiter"
                                          IsChecked="{x:Bind ViewModel.IsLimiterEnabled, Mode=TwoWay}" />

                                <NumberBox Header="Global Speed Limit (KB/s):"
                                           Value="{x:Bind ViewModel.SpeedLimitKbps, Mode=TwoWay}"
                                           IsEnabled="{x:Bind ViewModel.IsLimiterEnabled, Mode=OneWay}"
                                           Minimum="16" Maximum="1000000" SmallChange="128" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- TAB 5: BitTorrent -->
            <TabViewItem Header="BitTorrent" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel Spacing="12">
                        <!-- Port & NAT -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Listening Port &amp; NAT:" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Header="Incoming Listen Port:"
                                               Value="{x:Bind ViewModel.TorrentListenPort, Mode=TwoWay}"
                                               Minimum="1024" Maximum="65535" SmallChange="1" SpinButtonPlacementMode="Inline" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Randomize"
                                            Command="{x:Bind ViewModel.RandomizePortCommand}" Margin="0,0,0,2" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="6" Margin="0,0,0,2">
                                        <Button Content="Test Port" Command="{x:Bind ViewModel.TestPortCommand}" />
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsTestingPort, Mode=OneWay}" Width="16" Height="16" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.PortTestStatus, Mode=OneWay}"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <CheckBox Content="Randomize incoming listen port on application startup"
                                          IsChecked="{x:Bind ViewModel.TorrentRandomizePortOnStartup, Mode=TwoWay}" />
                                <CheckBox Content="Enable UPnP / NAT-PMP automatic port forwarding"
                                          IsChecked="{x:Bind ViewModel.TorrentEnableUpnp, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Protocol & Encryption -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Protocol &amp; Encryption:" FontWeight="SemiBold" />
                                <ComboBox Header="Peer Encryption Mode:" HorizontalAlignment="Stretch"
                                          SelectedIndex="{x:Bind ViewModel.TorrentEncryptionModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Prefer Encryption (RC4 with Plaintext fallback)" />
                                    <ComboBoxItem Content="Require Encryption (Strict RC4 encryption only)" />
                                    <ComboBoxItem Content="Allow Plaintext (No encryption required)" />
                                </ComboBox>
                                <CheckBox Content="Enable Distributed Hash Table (DHT / trackerless networks)"
                                          IsChecked="{x:Bind ViewModel.TorrentEnableDht, Mode=TwoWay}" />
                                <CheckBox Content="Enable Peer Exchange (PeX / BEP 11)"
                                          IsChecked="{x:Bind ViewModel.TorrentEnablePex, Mode=TwoWay}" />
                                <CheckBox Content="Enable Local Peer Discovery (LSD / multicast)"
                                          IsChecked="{x:Bind ViewModel.TorrentEnableLsd, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Connections & Limits -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Connections &amp; Bandwidth Limits:" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Grid.Column="0" Header="Maximum Global Connections:"
                                               Value="{x:Bind ViewModel.TorrentMaxConnections, Mode=TwoWay}"
                                               Minimum="10" Maximum="2000" SmallChange="10" SpinButtonPlacementMode="Inline" />
                                    <NumberBox Grid.Column="1" Header="Max Connections per Torrent:"
                                               Value="{x:Bind ViewModel.TorrentMaxConnectionsPerTorrent, Mode=TwoWay}"
                                               Minimum="5" Maximum="300" SmallChange="5" SpinButtonPlacementMode="Inline" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Grid.Column="0" Header="Max Download Rate (KB/s, 0=unlimited):"
                                               Value="{x:Bind ViewModel.TorrentMaxDownloadRateKbps, Mode=TwoWay}"
                                               Minimum="0" Maximum="1000000" SmallChange="128" SpinButtonPlacementMode="Inline" />
                                    <NumberBox Grid.Column="1" Header="Max Upload Rate (KB/s, 0=unlimited):"
                                               Value="{x:Bind ViewModel.TorrentMaxUploadRateKbps, Mode=TwoWay}"
                                               Minimum="0" Maximum="1000000" SmallChange="128" SpinButtonPlacementMode="Inline" />
                                </Grid>

                                <TextBlock Text="Alternative (Snail Mode) Speed Limits:" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Grid.Column="0" Header="Snail Download Limit (KB/s):"
                                               Value="{x:Bind ViewModel.TorrentAltDownloadRateKbps, Mode=TwoWay}"
                                               Minimum="16" Maximum="1000000" SmallChange="64" SpinButtonPlacementMode="Inline" />
                                    <NumberBox Grid.Column="1" Header="Snail Upload Limit (KB/s):"
                                               Value="{x:Bind ViewModel.TorrentAltUploadRateKbps, Mode=TwoWay}"
                                               Minimum="16" Maximum="1000000" SmallChange="64" SpinButtonPlacementMode="Inline" />
                                </Grid>

                                <CheckBox Content="Enable Scheduled Speed Limits (active daily during specified hours)"
                                          IsChecked="{x:Bind ViewModel.TorrentEnableSchedule, Mode=TwoWay}" Margin="0,4,0,0" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Grid.Column="0" Header="Schedule Start Hour (0-23):"
                                               Value="{x:Bind ViewModel.TorrentScheduleStartHour, Mode=TwoWay}"
                                               IsEnabled="{x:Bind ViewModel.TorrentEnableSchedule, Mode=OneWay}"
                                               Minimum="0" Maximum="23" SmallChange="1" SpinButtonPlacementMode="Inline" />
                                    <NumberBox Grid.Column="1" Header="Schedule End Hour (0-23):"
                                               Value="{x:Bind ViewModel.TorrentScheduleEndHour, Mode=TwoWay}"
                                               IsEnabled="{x:Bind ViewModel.TorrentEnableSchedule, Mode=OneWay}"
                                               Minimum="0" Maximum="23" SmallChange="1" SpinButtonPlacementMode="Inline" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Storage & Seeding Rules -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Storage &amp; Seeding Rules:" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="Default Torrent Save Directory:"
                                             Text="{x:Bind ViewModel.TorrentDefaultSaveDirectory, Mode=TwoWay}"
                                             PlaceholderText="C:\Users\...\Downloads" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse..."
                                            Click="BrowseDefaultSaveDirectory_Click" Margin="0,0,0,2" />
                                </Grid>

                                <CheckBox Content="Append .swiftget extension to incomplete files"
                                          IsChecked="{x:Bind ViewModel.TorrentUsePartialFiles, Mode=TwoWay}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Grid.Column="0" Header="Default Seed Ratio (0=unlimited):"
                                               Value="{x:Bind ViewModel.TorrentDefaultSeedRatio, Mode=TwoWay}"
                                               Minimum="0" Maximum="100" SmallChange="0.5" SpinButtonPlacementMode="Inline" />
                                    <NumberBox Grid.Column="1" Header="Seed Time Limit (mins, 0=unlimited):"
                                               Value="{x:Bind ViewModel.TorrentDefaultSeedTimeMins, Mode=TwoWay}"
                                               Minimum="0" Maximum="100000" SmallChange="30" SpinButtonPlacementMode="Inline" />
                                </Grid>

                                <CheckBox Content="Stop seeding automatically when ratio or time limit is reached"
                                          IsChecked="{x:Bind ViewModel.TorrentStopSeedingWhenLimitReached, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Default Trackers -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Default Public Trackers:" FontWeight="SemiBold" />
                                <TextBlock Text="These verified trackers will be appended to new magnet links and torrents to guarantee fast peer discovery:"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBox Text="{x:Bind ViewModel.TorrentDefaultTrackersText, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="90"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <Button Content="Reset Trackers to Recommended"
                                        Command="{x:Bind ViewModel.ResetTrackersCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- IP Filter / Blocklist -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="IP Filter / P2P Blocklist:" FontWeight="SemiBold" />
                                <CheckBox Content="Enable IP Filter (Blocklist)"
                                          IsChecked="{x:Bind ViewModel.TorrentEnableIpFilter, Mode=TwoWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="IP Filter File Path (ipfilter.dat or P2P blocklist):"
                                             Text="{x:Bind ViewModel.TorrentIpFilterPath, Mode=TwoWay}"
                                             IsEnabled="{x:Bind ViewModel.TorrentEnableIpFilter, Mode=OneWay}"
                                             PlaceholderText="C:\...\ipfilter.dat" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse..."
                                            Click="BrowseIpFilter_Click"
                                            IsEnabled="{x:Bind ViewModel.TorrentEnableIpFilter, Mode=OneWay}"
                                            Margin="0,0,0,2" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.IpFilterStatus, Mode=OneWay}"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Associations -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Windows File Associations:" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.AssociationStatus, Mode=OneWay}"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Register as Default (.torrent &amp; magnet:)"
                                            Command="{x:Bind ViewModel.RegisterAssociationsCommand}" />
                                    <Button Content="Default Apps Settings"
                                            Command="{x:Bind ViewModel.OpenDefaultAppsCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Reset Defaults Button -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Reset BitTorrent Configuration:" FontWeight="SemiBold" />
                                <TextBlock Text="Restore all BitTorrent ports, protocol settings, connection limits, and recommended trackers to standard defaults."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Button Content="Reset BitTorrent Settings to Defaults"
                                        Command="{x:Bind ViewModel.ResetTorrentDefaultsCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- TAB 6: Updates -->
            <TabViewItem Header="Updates" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel Spacing="12">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Image Source="ms-appx:///Assets/Square50x50Logo.png" Width="40" Height="40" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SwiftGet Download Manager" FontWeight="Bold" FontSize="15" />
                                        <TextBlock Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBox Header="Update Feed URL:"
                                         Text="{x:Bind ViewModel.UpdateFeedUrl, Mode=TwoWay}" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Check for Updates Now"
                                            Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}"
                                                  Width="20" Height="20" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- TAB 7: Browser Integration -->
            <TabViewItem Header="Browser Integration" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel Spacing="12">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="10">
                                <CheckBox Content="Capture downloads from browser"
                                          IsChecked="{x:Bind ViewModel.BrowserCaptureEnabled, Mode=TwoWay}"
                                          FontWeight="SemiBold"
                                          AutomationProperties.Name="Capture downloads from browser" />

                                <ComboBox Header="Capture Mode:"
                                          HorizontalAlignment="Stretch"
                                          SelectedIndex="{x:Bind ViewModel.BrowserCaptureModeIndex, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.BrowserCaptureEnabled, Mode=OneWay}"
                                          AutomationProperties.Name="Capture Mode">
                                    <ComboBoxItem Content="Ask me (Show Download File Info dialog — Default)" />
                                    <ComboBoxItem Content="Auto-start immediately without asking" />
                                    <ComboBoxItem Content="Off (Never capture browser downloads)" />
                                </ComboBox>

                                <NumberBox Header="Minimum File Size to Auto-Capture (KB):"
                                           Value="{x:Bind ViewModel.BrowserMinFileSizeKb, Mode=TwoWay}"
                                           IsEnabled="{x:Bind ViewModel.BrowserCaptureEnabled, Mode=OneWay}"
                                           Minimum="0" Maximum="1048576" SmallChange="64" SpinButtonPlacementMode="Inline" />

                                <TextBox Header="Ignore List (Domains, URL patterns, or filenames — one per line):"
                                         Text="{x:Bind ViewModel.BrowserIgnorePatternsText, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         Height="80"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PlaceholderText="claude.ai/api&#x0a;*/api/*&#x0a;localhost" />

                                <TextBox Header="Allowed File Extensions (space-separated):"
                                         Text="{x:Bind ViewModel.BrowserAllowedExtensionsText, Mode=TwoWay}"
                                         PlaceholderText=".zip .rar .7z .exe .msi .iso .mp4 .pdf" />
                            </StackPanel>
                        </Border>

                        <!-- Capture Log & Clear State -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Capture Decision Log (Last 100):" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Refresh Log"
                                            Command="{x:Bind ViewModel.RefreshCaptureLogCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Clear capture state"
                                            Command="{x:Bind ViewModel.ClearCaptureStateCommand}"
                                            AutomationProperties.Name="Clear capture state" />
                                </Grid>

                                <ListView ItemsSource="{x:Bind ViewModel.CaptureLogLines, Mode=OneWay}"
                                          Height="110"
                                          SelectionMode="None"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                          BorderThickness="1"
                                          CornerRadius="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" FontSize="11" FontFamily="Consolas" TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <!-- Status Message -->
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,8,4,0" />
    </Grid>
</ContentDialog>
