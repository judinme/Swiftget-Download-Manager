<ContentDialog
    x:Class="SwiftGet.App.Views.MediaDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SwiftGet.App.ViewModels"
    xmlns:models="using:SwiftGet.Media.Models"
    Title="Download Streaming Media"
    PrimaryButtonText="Download"
    SecondaryButtonText="Add to Queue"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Width="640">

    <Grid RowSpacing="12" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: URL Input & Probe Button (Flush edges, no overlap) -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Video / Media Web Address:"
                     Text="{x:Bind ViewModel.MediaUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="https://www.youtube.com/watch?v=..."
                     AutomationProperties.Name="Video or Media Web Address" />
            <Button Grid.Column="1" Content="Fetch Info"
                    Command="{x:Bind ViewModel.ProbeMediaCommand}"
                    IsEnabled="{x:Bind ViewModel.CanProbe, Mode=OneWay}"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Fetch Media Info" />
        </Grid>

        <!-- Row 1: DRM Notice Banner -->
        <Border Grid.Row="1" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12"
                Visibility="{x:Bind ViewModel.DrmNoticeVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.DrmMessage, Mode=OneWay}"
                           TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Row 2: Error InfoBar with Retry, Fix Path and Copy Details -->
        <InfoBar Grid.Row="2"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 Title="Media Extraction Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsClosable="False">
            <InfoBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Retry"
                            Command="{x:Bind ViewModel.RetryProbeCommand}"
                            AutomationProperties.Name="Retry media extraction" />
                    <Button Content="Fix automatically"
                            Command="{x:Bind ViewModel.FixPathAutomaticallyCommand}"
                            AutomationProperties.Name="Resolve folder path automatically" />
                    <Button Content="Copy details"
                            Command="{x:Bind ViewModel.CopyErrorDetailsCommand}"
                            AutomationProperties.Name="Copy error details to clipboard" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- Row 3: Media Details & Format Selection -->
        <StackPanel Grid.Row="3" Spacing="12" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <!-- Media Info Card with Loading ProgressRing and State Icon -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon / Progress Ring Area -->
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="4"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsProbing, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsProbing, Mode=OneWay}"
                                          Width="32" Height="32" />
                            <FontIcon Glyph="&#xE714;" FontSize="28"
                                      Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                    </Border>

                    <!-- Title, Uploader, Duration -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                   FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="2" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.Uploader, Mode=OneWay}"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.DurationFormatted, Mode=OneWay}"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Format & Quality Dropdown -->
            <ComboBox Header="Quality &amp; Format:" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.Formats}"
                      SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.CanDownload, Mode=OneWay}"
                      PlaceholderText="No formats available"
                      AutomationProperties.Name="Select Quality and Format">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaFormat">
                        <TextBlock Text="{x:Bind QualityLabel}" FontSize="12" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- File Name & Save Directory -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="File Name:"
                         Text="{x:Bind ViewModel.FileName, Mode=TwoWay}"
                         AutomationProperties.Name="Media File Name" />
                <TextBox Grid.Column="1" Header="Save Directory:"
                         Text="{x:Bind ViewModel.SaveDirectory, Mode=TwoWay}"
                         AutomationProperties.Name="Save Directory" />
            </Grid>
        </StackPanel>

        <!-- Row 4: Status Message -->
        <StackPanel Grid.Row="4" Spacing="4">
            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsProbing, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsProbing, Mode=OneWay}" Height="3" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ContentDialog>
