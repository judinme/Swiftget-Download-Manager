<Window
    x:Class="SwiftGet.App.Views.DownloadProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SwiftGet.App.Controls"
    xmlns:converters="using:SwiftGet.App.Converters"
    xmlns:vm="using:SwiftGet.App.ViewModels"
    Title="SwiftGet Download Progress">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 3-Tab Pivot / TabView -->
        <TabView Grid.Row="0" CanReorderTabs="False" IsAddTabButtonVisible="False" SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}">
            <!-- TAB 1: Download Status -->
            <TabViewItem Header="Download status" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE896;" />
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                    <StackPanel Spacing="10">
                        <!-- Key-Value Info Grid -->
                        <Grid ColumnSpacing="12" RowSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="URL:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Item.Url, Mode=OneWay}" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Item.StatusText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.Item.StatusBrush, Mode=OneWay}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="File size:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Item.FormattedSize, Mode=OneWay}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Downloaded:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Item.FormattedDownloaded, Mode=OneWay}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Transfer rate:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.Item.FormattedSpeed, Mode=OneWay}" FontWeight="SemiBold" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Time left:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.Item.FormattedTimeLeft, Mode=OneWay}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Resume capability:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="Yes" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Grid>

                        <!-- Overall Standard Progress Bar -->
                        <ProgressBar
                            Height="10"
                            Minimum="0"
                            Maximum="100"
                            Value="{x:Bind ViewModel.Item.ProgressPercentage, Mode=OneWay}"
                            HorizontalAlignment="Stretch" />

                        <!-- Segmented Progress Bar (IDM Parity Signature Control) -->
                        <controls:SegmentedProgressBar
                            x:Name="SegmentBar"
                            Segments="{x:Bind ViewModel.ConnectionRows, Mode=OneWay}"
                            OverallProgress="{x:Bind ViewModel.Item.ProgressPercentage, Mode=OneWay}"
                            HorizontalAlignment="Stretch" />

                        <!-- Live Per-Connection Details Table -->
                        <StackPanel Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}" Spacing="6">
                            <TextBlock Text="Active Connections:" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <controls:ConnectionTableControl ItemsSource="{x:Bind ViewModel.ConnectionRows, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- TAB 2: Speed Limiter -->
            <TabViewItem Header="Speed Limiter" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xEC4A;" />
                </TabViewItem.IconSource>
                <StackPanel Spacing="14" Padding="12,14">
                    <CheckBox Content="Use Speed Limiter" IsChecked="{x:Bind ViewModel.IsLimiterEnabled, Mode=TwoWay}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            Grid.Column="0"
                            Minimum="64"
                            Maximum="102400"
                            StepFrequency="64"
                            Value="{x:Bind ViewModel.SpeedLimitKbps, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsLimiterEnabled, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind ViewModel.SpeedLimitKbps, Mode=OneWay}"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold" />
                    </Grid>

                    <TextBlock Text="Maximum download speed (in KB/s). SwiftGet will shape network traffic using token-bucket rate limiting."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </TabViewItem>

            <!-- TAB 3: Options on Completion -->
            <TabViewItem Header="Options on completion" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE713;" />
                </TabViewItem.IconSource>
                <StackPanel Spacing="10" Padding="12,14">
                    <CheckBox Content="Close this dialog when download completes" IsChecked="{x:Bind ViewModel.CloseOnCompletion, Mode=TwoWay}" />
                    <CheckBox Content="Exit SwiftGet after completing this download" IsChecked="{x:Bind ViewModel.ExitAppOnCompletion, Mode=TwoWay}" />
                    <CheckBox Content="Shut down computer after completion" IsChecked="{x:Bind ViewModel.ShutdownOnCompletion, Mode=TwoWay}" />
                    <CheckBox Content="Play notification sound on completion" IsChecked="{x:Bind ViewModel.PlaySoundOnCompletion, Mode=TwoWay}" />
                </StackPanel>
            </TabViewItem>
        </TabView>

        <!-- Dialog Buttons Row -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Content="{x:Bind ViewModel.DetailsButtonText, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleDetailsCommand}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button
                    Content="Pause"
                    Command="{x:Bind ViewModel.TogglePauseCommand}"
                    Width="80" />
                <Button
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Width="80" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
