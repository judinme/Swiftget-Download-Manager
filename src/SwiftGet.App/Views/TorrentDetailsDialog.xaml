<ContentDialog
    x:Class="SwiftGet.App.Views.TorrentDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SwiftGet.App.ViewModels"
    xmlns:models="using:SwiftGet.Engine.Torrent"
    Title="BitTorrent Inspector &amp; Swarm Details"
    PrimaryButtonText="Close"
    DefaultButton="Primary"
    Width="780"
    Height="620">

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Tab Control -->
        <TabView Grid.Row="0" IsAddTabButtonVisible="False" TabWidthMode="Equal">
            <!-- TAB 1: General -->
            <TabViewItem Header="General" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel Spacing="12">
                        <!-- Key Stats Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14">
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.TorrentName, Mode=OneWay}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Info Hash:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.InfoHash, Mode=OneWay}" FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Save Folder:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SaveDirectory, Mode=OneWay}" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.StatusBrush, Mode=OneWay}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Transfer Speeds:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.FormattedSpeed, Mode=OneWay}" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Downloaded / Size:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.FormattedDownloaded, Mode=OneWay}" FontWeight="Medium" />
                                    <TextBlock Text="of" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedSize, Mode=OneWay}" FontWeight="Medium" />
                                    <TextBlock Text="• Uploaded:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedUploaded, Mode=OneWay}" />
                                    <TextBlock Text="• Ratio:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" />
                                    <TextBlock Text="{x:Bind ViewModel.ShareRatioText, Mode=OneWay}" FontWeight="SemiBold" />
                                </StackPanel>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Swarm Seeds:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.SwarmSeedsText, Mode=OneWay}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Swarm Peers:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.SwarmPeersText, Mode=OneWay}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Pieces:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Bind ViewModel.PieceStatsText, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <!-- Progress Bar -->
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Transfer Progress" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FormattedTimeLeft, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ProgressBar Grid.Row="1" Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" Maximum="100" Height="8" CornerRadius="4" />
                        </Grid>

                        <!-- Quick Actions -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Force Recheck" Command="{x:Bind ViewModel.ForceRecheckCommand}">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="F5" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Button Content="Toggle Sequential" Command="{x:Bind ViewModel.ToggleSequentialCommand}" />
                                <Button Content="Copy Magnet URI" Command="{x:Bind ViewModel.CopyMagnetUriCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- TAB 2: Files -->
            <TabViewItem Header="Files" IsClosable="False">
                <Grid Padding="4,8" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="File Path" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="Size" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="Done" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Progress" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Priority" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TorrentFileItemViewModel">
                                <Grid Margin="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedSize}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedDownloaded, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />

                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                        <ProgressBar Value="{x:Bind ProgressPercentage, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" />
                                    </Grid>

                                    <ComboBox Grid.Column="4"
                                              SelectedIndex="{x:Bind SelectedPriorityIndex, Mode=TwoWay}"
                                              ItemsSource="{x:Bind PriorityOptions}"
                                              FontSize="11" Padding="6,2" HorizontalAlignment="Stretch" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <!-- TAB 3: Peers -->
            <TabViewItem Header="Peers" IsClosable="False">
                <Grid Padding="4,8" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IP:Port" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="Client" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="Down Rate" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Up Rate" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Flags" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Security" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="Type" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Peers}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TorrentPeerDisplayItem">
                                <Grid Margin="0,3" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind Endpoint}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Client}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind DownloadSpeedText}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind UploadSpeedText}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Flags}" HorizontalAlignment="Center" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind EncryptionText}" HorizontalAlignment="Center" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind ProtocolText}" HorizontalAlignment="Center" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <!-- TAB 4: Trackers -->
            <TabViewItem Header="Trackers" IsClosable="False">
                <Grid Padding="4,8" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tier" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Announce URL" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="3" Text="Seeds" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Peers" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Trackers}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TorrentTrackerInfo">
                                <Grid Margin="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind Tier}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind AnnounceUrl}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Seeds}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Peers}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <!-- TAB 5: Piece Map -->
            <TabViewItem Header="Piece Map" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel Spacing="16">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Swarm Piece Verification Map" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.PieceMapSummary, Mode=OneWay}"
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressBar Value="{x:Bind ViewModel.PieceCompletionPercentage, Mode=OneWay}" Maximum="100" Height="10" CornerRadius="5" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Piece Distribution Grid (Sampled Overview):" FontWeight="SemiBold" FontSize="12" />
                                <GridView ItemsSource="{x:Bind ViewModel.PieceBlocks}" SelectionMode="None">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PieceBlockViewModel">
                                            <Rectangle Width="9" Height="14" Fill="{x:Bind BlockBrush, Mode=OneWay}" RadiusX="2" RadiusY="2" Margin="1" />
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Rectangle Width="12" Height="12" Fill="#107C41" RadiusX="2" RadiusY="2" />
                                        <TextBlock Text="Verified Downloaded" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Rectangle Width="12" Height="12" Fill="#C8C8C8" RadiusX="2" RadiusY="2" />
                                        <TextBlock Text="Pending Verification" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- TAB 6: Speed Limits -->
            <TabViewItem Header="Speed Limits" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel Spacing="12">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Per-Torrent Bandwidth Throttling:" FontWeight="SemiBold" />

                                <NumberBox Header="Maximum Download Rate (KB/s, 0 = unlimited):"
                                           Value="{x:Bind ViewModel.DownloadLimitKbps, Mode=TwoWay}"
                                           Minimum="0" Maximum="1000000" SmallChange="128" SpinButtonPlacementMode="Inline" />

                                <NumberBox Header="Maximum Upload Rate (KB/s, 0 = unlimited):"
                                           Value="{x:Bind ViewModel.UploadLimitKbps, Mode=TwoWay}"
                                           Minimum="0" Maximum="1000000" SmallChange="128" SpinButtonPlacementMode="Inline" />

                                <Button Content="Apply Rate Limits"
                                        Command="{x:Bind ViewModel.ApplySpeedLimitsCommand}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <!-- Status Message -->
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,8,4,0" />
    </Grid>
</ContentDialog>
