<UserControl
    x:Class="SwiftGet.App.Views.DownloadDetailsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SwiftGet.App.ViewModels"
    xmlns:converters="using:SwiftGet.App.Converters"
    xmlns:controls="using:SwiftGet.App.Controls"
    mc:Ignorable="d"
    d:DesignHeight="185"
    d:DesignWidth="780">

    <UserControl.Resources>
        <converters:TabNameToVisibilityConverter x:Key="TabNameToVisibility"/>
        <converters:TabNameToBrushConverter x:Key="TabNameToBrush"/>
        <converters:TabNameToForegroundConverter x:Key="TabNameToForeground"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True"/>

        <Style x:Key="DetailTabButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <Style x:Key="GridHeaderButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#171717" BorderBrush="#262626" BorderThickness="0,1,0,0">
        <Grid.RowDefinitions>
            <!-- Top Splitter Grip (5px) -->
            <RowDefinition Height="5"/>
            <!-- Tab Header Bar (32px) -->
            <RowDefinition Height="32"/>
            <!-- Content Area (*) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Splitter Grip -->
        <Border Grid.Row="0"
                x:Name="SplitterBorder"
                Background="#1E1E1E"
                BorderBrush="#2A2A2A"
                BorderThickness="0,0,0,1"
                PointerPressed="Splitter_PointerPressed"
                PointerMoved="Splitter_PointerMoved"
                PointerReleased="Splitter_PointerReleased"/>

        <!-- Header Bar: 4 Pill Tabs + Close Button -->
        <Grid Grid.Row="1" Background="#1B1B1B" Padding="14,0,12,0" BorderBrush="#242424" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="GENERAL"
                        Style="{StaticResource DetailTabButtonStyle}"
                        Background="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToBrush}, ConverterParameter=GENERAL}"
                        Foreground="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToForeground}, ConverterParameter=GENERAL}"
                        Command="{x:Bind ViewModel.SelectTabCommand}"
                        CommandParameter="GENERAL"/>

                <Button Content="DETAILS"
                        Style="{StaticResource DetailTabButtonStyle}"
                        Background="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToBrush}, ConverterParameter=DETAILS}"
                        Foreground="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToForeground}, ConverterParameter=DETAILS}"
                        Command="{x:Bind ViewModel.SelectTabCommand}"
                        CommandParameter="DETAILS"/>

                <Button Content="PROGRESS"
                        Style="{StaticResource DetailTabButtonStyle}"
                        Background="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToBrush}, ConverterParameter=PROGRESS}"
                        Foreground="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToForeground}, ConverterParameter=PROGRESS}"
                        Command="{x:Bind ViewModel.SelectTabCommand}"
                        CommandParameter="PROGRESS"/>

                <Button Content="CONNECTIONS"
                        Style="{StaticResource DetailTabButtonStyle}"
                        Background="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToBrush}, ConverterParameter=CONNECTIONS}"
                        Foreground="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToForeground}, ConverterParameter=CONNECTIONS}"
                        Command="{x:Bind ViewModel.SelectTabCommand}"
                        CommandParameter="CONNECTIONS"/>

                <Button Content="LOG"
                        Style="{StaticResource DetailTabButtonStyle}"
                        Background="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToBrush}, ConverterParameter=LOG}"
                        Foreground="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToForeground}, ConverterParameter=LOG}"
                        Command="{x:Bind ViewModel.SelectTabCommand}"
                        CommandParameter="LOG"/>
            </StackPanel>

            <!-- Close Button (X) -->
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ClosePanelCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6,4"
                    ToolTipService.ToolTip="Close Download Details (Esc)">
                <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#888888"/>
            </Button>
        </Grid>

        <!-- Main Tabs Content -->
        <Grid Grid.Row="2" Padding="14,8,14,8">

            <!-- Multi-Select State -->
            <StackPanel Visibility="{x:Bind ViewModel.IsMultiSelect, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <FontIcon Glyph="&#xE762;" FontSize="24" Foreground="#666666"/>
                <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" Foreground="#888888" FontSize="12.5"/>
            </StackPanel>

            <!-- No Selection State -->
            <StackPanel Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <FontIcon Glyph="&#xE896;" FontSize="24" Foreground="#555555"/>
                <TextBlock Text="Select a download to view details" Foreground="#777777" FontSize="12.5"/>
            </StackPanel>

            <!-- Single Item View -->
            <Grid Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                <!-- ========================================== -->
                <!-- 1. GENERAL TAB                             -->
                <!-- ========================================== -->
                <Grid Visibility="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToVisibility}, ConverterParameter=GENERAL}"
                      ColumnDefinitions="Auto, *" ColumnSpacing="14">

                    <!-- Left: Large File or Folder Icon -->
                    <Border Grid.Column="0"
                            Width="74"
                            Height="74"
                            VerticalAlignment="Top"
                            Background="#121212"
                            BorderBrush="#262626"
                            BorderThickness="1"
                            CornerRadius="6">
                        <FontIcon Glyph="{x:Bind ViewModel.FileIconGlyph, Mode=OneWay}"
                                  Foreground="{x:Bind ViewModel.FileIconColor, Mode=OneWay}"
                                  FontSize="36"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- Right: Metadata & Details Grid -->
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Top">
                        <!-- File Name -->
                        <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
                                   Foreground="#FFFFFF"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.FileName, Mode=OneWay}"/>

                        <!-- Save Path with Copy Button and Toast -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.SaveFolder, Mode=OneWay}"
                                       Foreground="#8A8A8A"
                                       FontSize="11.5"
                                       MaxWidth="380"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Command="{x:Bind ViewModel.CopySavePathCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="3,1"
                                    ToolTipService.ToolTip="Copy full save path">
                                <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="#59B9F7"/>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenFolderCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="3,1"
                                    ToolTipService.ToolTip="Open folder in File Explorer">
                                <FontIcon Glyph="&#xE8DA;" FontSize="11" Foreground="#59B9F7"/>
                            </Button>
                            <TextBlock Text="Copied!"
                                       Foreground="#2CCB70"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Visibility="{x:Bind ViewModel.IsSavePathCopiedNoticeVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <!-- Progress Bar & Remaining Time -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,3,0,4">
                            <ProgressBar Grid.Column="0"
                                         Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                                         Maximum="100"
                                         Height="3.5"
                                         VerticalAlignment="Center"
                                         Background="#2A2A2A"
                                         Foreground="#59B9F7"
                                         CornerRadius="2"
                                         Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.ProgressPercentText, Mode=OneWay}"
                                           Foreground="#D4D4D4"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.RemainingTimeText, Mode=OneWay}"
                                           Foreground="#8A8A8A"
                                           FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <!-- 2-Row Details Table -->
                        <Grid ColumnDefinitions="2*, 2*, 2*" RowDefinitions="Auto, Auto" RowSpacing="2" ColumnSpacing="12">
                            <!-- Row 0: Downloaded, Uploaded, Added at -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Downloaded:" FontSize="11" Foreground="#8A8A8A"/>
                                <TextBlock Text="{x:Bind ViewModel.DownloadedText, Mode=OneWay}" FontSize="11" Foreground="#D4D4D4" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Uploaded:" FontSize="11" Foreground="#8A8A8A"/>
                                <TextBlock Text="{x:Bind ViewModel.UploadedText, Mode=OneWay}" FontSize="11" Foreground="#D4D4D4" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Added at:" FontSize="11" Foreground="#8A8A8A"/>
                                <TextBlock Text="{x:Bind ViewModel.AddedAtText, Mode=OneWay}" FontSize="11" Foreground="#D4D4D4" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Row 1: Download Speed, Upload Speed, Priority -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Download speed:" FontSize="11" Foreground="#8A8A8A"/>
                                <TextBlock Text="{x:Bind ViewModel.DownloadSpeedText, Mode=OneWay}" FontSize="11" Foreground="#3B9EFF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Upload speed:" FontSize="11" Foreground="#8A8A8A"/>
                                <TextBlock Text="{x:Bind ViewModel.UploadSpeedText, Mode=OneWay}" FontSize="11" Foreground="#2CCB70" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Priority:" FontSize="11" Foreground="#8A8A8A"/>
                                <TextBlock Text="{x:Bind ViewModel.PriorityText, Mode=OneWay}" FontSize="11" Foreground="#D4D4D4" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Web page URL -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                            <TextBlock Text="Web page:" FontSize="11" Foreground="#8A8A8A" VerticalAlignment="Center"/>
                            <HyperlinkButton Content="{x:Bind ViewModel.FormattedSourcePageUrl, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.OpenWebPageCommand}"
                                             Foreground="#3B9EFF"
                                             FontSize="11"
                                             Padding="0"
                                             MinHeight="0"
                                             MinWidth="0"
                                             VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ========================================== -->
                <!-- 2. DETAILS TAB                             -->
                <!-- ========================================== -->
                <Grid Visibility="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToVisibility}, ConverterParameter=DETAILS}">

                    <!-- Torrent View -->
                    <Grid Visibility="{x:Bind ViewModel.IsTorrent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                          RowDefinitions="Auto, *">
                        <!-- Top Swarm Telemetry -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="3" Margin="0,0,0,8">
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Peers:" FontSize="11.5" Foreground="#8A8A8A"/>
                                <TextBlock Text="{x:Bind ViewModel.PeersText, Mode=OneWay}" FontSize="11.5" Foreground="#D4D4D4" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Seeds:" FontSize="11.5" Foreground="#8A8A8A"/>
                                <TextBlock Text="{x:Bind ViewModel.SeedsText, Mode=OneWay}" FontSize="11.5" Foreground="#D4D4D4" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Availability:" FontSize="11.5" Foreground="#8A8A8A"/>
                                <TextBlock Text="{x:Bind ViewModel.AvailabilityText, Mode=OneWay}" FontSize="11.5" Foreground="#D4D4D4" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Last seen complete:" FontSize="11.5" Foreground="#8A8A8A"/>
                                <TextBlock Text="{x:Bind ViewModel.LastSeenCompleteText, Mode=OneWay}" FontSize="11.5" Foreground="#D4D4D4"/>
                            </StackPanel>
                        </Grid>

                        <!-- Trackers Table -->
                        <Grid Grid.Row="1" RowDefinitions="Auto, *">
                            <Grid Grid.Row="0" ColumnDefinitions="2*, *, Auto" Background="#1B1B1B" Padding="8,4" CornerRadius="4,4,0,0">
                                <TextBlock Grid.Column="0" Text="Tracker URL" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="Force Announce" Command="{x:Bind ViewModel.ForceAnnounceCommand}" FontSize="10" Padding="6,2" VerticalAlignment="Center" />
                            </Grid>
                            <ListView Grid.Row="1"
                                      ItemsSource="{x:Bind ViewModel.Trackers, Mode=OneWay}"
                                      SelectionMode="None"
                                      Background="#141414"
                                      CornerRadius="0,0,4,4"
                                      Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TrackerItemViewModel">
                                        <Grid ColumnDefinitions="2*, *" Padding="8,3">
                                            <TextBlock Grid.Column="0" Text="{x:Bind AnnounceUrl}" Foreground="#D4D4D4" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Status}" Foreground="{x:Bind StatusColor}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>

                    <!-- HTTP / Media View -->
                    <Grid Visibility="{x:Bind ViewModel.IsHttpOrMedia, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                          RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="6" Margin="4,4,0,0">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Server:" FontSize="11.5" Foreground="#8A8A8A"/>
                            <TextBlock Text="{x:Bind ViewModel.HttpServer, Mode=OneWay}" FontSize="11.5" Foreground="#D4D4D4" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Resume support:" FontSize="11.5" Foreground="#8A8A8A"/>
                            <TextBlock Text="{x:Bind ViewModel.HttpResumeSupport, Mode=OneWay}" FontSize="11.5" Foreground="#2CCB70" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Content-Type:" FontSize="11.5" Foreground="#8A8A8A"/>
                            <TextBlock Text="{x:Bind ViewModel.HttpContentType, Mode=OneWay}" FontSize="11.5" Foreground="#D4D4D4"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Redirect target:" FontSize="11.5" Foreground="#8A8A8A"/>
                            <TextBlock Text="{x:Bind ViewModel.HttpRedirectTarget, Mode=OneWay}" FontSize="11.5" Foreground="#D4D4D4"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Segment count:" FontSize="11.5" Foreground="#8A8A8A"/>
                            <TextBlock Text="{x:Bind ViewModel.HttpSegmentCount, Mode=OneWay}" FontSize="11.5" Foreground="#59B9F7" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ========================================== -->
                <!-- 3. PROGRESS TAB                            -->
                <!-- ========================================== -->
                <Grid Visibility="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToVisibility}, ConverterParameter=PROGRESS}"
                      RowDefinitions="*, Auto">
                    <!-- High Performance Custom Pixel Grid -->
                    <controls:PieceMapControl Grid.Row="0"
                                              x:Name="PieceMap"
                                              PieceCells="{x:Bind ViewModel.PieceCells, Mode=OneWay}"
                                              Margin="0,0,0,6"/>

                    <!-- Bottom Legend & Piece Counter -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto, *">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Width="8" Height="8" Background="#262626" CornerRadius="1"/>
                                <TextBlock Text="Missing" FontSize="10" Foreground="#808080"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Width="8" Height="8" Background="#1E90FF" CornerRadius="1"/>
                                <TextBlock Text="Downloading" FontSize="10" Foreground="#808080"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Width="8" Height="8" Background="#2ECC71" CornerRadius="1"/>
                                <TextBlock Text="Complete" FontSize="10" Foreground="#808080"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border Width="8" Height="8" Background="#F1C40F" CornerRadius="1"/>
                                <TextBlock Text="Verifying" FontSize="10" Foreground="#808080"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.PiecesSummaryText, Mode=OneWay}"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="#A0A0A0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- ========================================== -->
                <!-- 4. CONNECTIONS TAB                         -->
                <!-- ========================================== -->
                <Grid Visibility="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToVisibility}, ConverterParameter=CONNECTIONS}"
                      RowDefinitions="Auto, *">
                    <!-- Table Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="2*, 0.8*, 0.8*, 0.8*, 1.5*" Background="#1B1B1B" Padding="8,2" CornerRadius="4,4,0,0">
                        <Button Grid.Column="0" Content="Host" Style="{StaticResource GridHeaderButtonStyle}" Command="{x:Bind ViewModel.SortConnectionsCommand}" CommandParameter="Host"/>
                        <Button Grid.Column="1" Content="Port" Style="{StaticResource GridHeaderButtonStyle}" Command="{x:Bind ViewModel.SortConnectionsCommand}" CommandParameter="Port"/>
                        <Button Grid.Column="2" Content="Count" Style="{StaticResource GridHeaderButtonStyle}" Command="{x:Bind ViewModel.SortConnectionsCommand}" CommandParameter="ConnectionCount"/>
                        <Button Grid.Column="3" Content="Direction" Style="{StaticResource GridHeaderButtonStyle}" Command="{x:Bind ViewModel.SortConnectionsCommand}" CommandParameter="Direction"/>
                        <Button Grid.Column="4" Content="Client" Style="{StaticResource GridHeaderButtonStyle}" Command="{x:Bind ViewModel.SortConnectionsCommand}" CommandParameter="Client"/>
                    </Grid>

                    <!-- Table Rows -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}"
                              SelectionMode="None"
                              Background="#141414"
                              CornerRadius="0,0,4,4"
                              Padding="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConnectionItemViewModel">
                                <Grid ColumnDefinitions="2*, 0.8*, 0.8*, 0.8*, 1.5*" Padding="8,4">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Copy IP" Click="CopyIp_Click"/>
                                            <MenuFlyoutItem Text="Copy IP:Port" Click="CopyIpPort_Click"/>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Host}" Foreground="#FFFFFF" FontSize="11.5" FontFamily="Consolas, Segoe UI" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Port}" Foreground="#D4D4D4" FontSize="11.5" FontFamily="Consolas, Segoe UI"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ConnectionCount}" Foreground="#D4D4D4" FontSize="11.5"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Direction}" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind Client}" Foreground="#59B9F7" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- ========================================== -->
                <!-- 5. LOG TAB                                  -->
                <!-- ========================================== -->
                <Grid Visibility="{x:Bind ViewModel.ActiveTab, Mode=OneWay, Converter={StaticResource TabNameToVisibility}, ConverterParameter=LOG}"
                      RowDefinitions="Auto, *">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <Button Content="Copy Logs" Command="{x:Bind ViewModel.CopyLogsCommand}" FontSize="11" Padding="8,3"/>
                        <Button Content="Export Logs..." Command="{x:Bind ViewModel.ExportLogsCommand}" FontSize="11" Padding="8,3"/>
                        <Button Content="Open Logs Folder" Command="{x:Bind ViewModel.OpenLogsFolderCommand}" FontSize="11" Padding="8,3"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
                            <TextBox Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="11"
                                     Foreground="#D0D0D0"
                                     BorderThickness="0"
                                     Background="Transparent"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>