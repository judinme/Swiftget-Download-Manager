<ContentDialog
    x:Class="SwiftGet.App.Views.DownloadCompleteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Download complete"
    CloseButtonText="Close"
    Width="580">

    <Grid RowSpacing="12" Margin="0,6,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header with Fluent Success Checkmark -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE73E;" FontSize="22"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Download complete" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Left" TextAlignment="Left" />
                <TextBlock x:Name="SubtitleTextBlock"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Left" TextAlignment="Left" />
            </StackPanel>
        </Grid>

        <!-- Dangerous File Type Warning InfoBar -->
        <InfoBar Grid.Row="1" x:Name="DangerousWarningBar"
                 Severity="Warning"
                 IsOpen="False"
                 IsClosable="False"
                 Title="Security Warning"
                 Message="This file type (.exe, .msi, script) can harm your computer. Make sure you trust the source before opening." />

        <!-- Address (URL) -->
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="Address" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Left" TextAlignment="Left"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="UrlTextBox" IsReadOnly="True"
                     TextWrapping="NoWrap"
                     AutomationProperties.Name="Downloaded Address" />
        </StackPanel>

        <!-- Saved As (Path) -->
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="The file saved as" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Left" TextAlignment="Left"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="SavePathTextBox" IsReadOnly="True"
                     TextWrapping="NoWrap"
                     AutomationProperties.Name="Saved File Path" />
        </StackPanel>

        <!-- Checkbox Row (dedicated full row to prevent label wrapping) -->
        <Grid Grid.Row="4" Margin="0,4,0,0">
            <CheckBox Content="Don't show this dialog again" FontSize="12"
                      AutomationProperties.Name="Don't show this dialog again" />
        </Grid>

        <!-- Action Buttons Row (right-aligned, MinWidth, no wrapping) -->
        <Grid Grid.Row="5" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Open" Click="Open_Click"
                        Style="{ThemeResource AccentButtonStyle}"
                        MinWidth="85"
                        AutomationProperties.Name="Open downloaded file" />
                <Button Content="Open with..." Click="OpenWith_Click"
                        MinWidth="100"
                        AutomationProperties.Name="Open file with application" />
                <Button Content="Open folder" Click="OpenFolder_Click"
                        MinWidth="100"
                        AutomationProperties.Name="Open containing folder" />
                <Button Width="40" Height="36"
                        ToolTipService.ToolTip="Drag and drop file into other applications"
                        AutomationProperties.Name="Drag file"
                        CanDrag="True" DragStarting="DragBadge_DragStarting"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7C2;" FontSize="16"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
