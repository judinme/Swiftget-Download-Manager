<Window
    x:Class="SwiftGet.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SwiftGet"
    mc:Ignorable="d"
    Title="SwiftGet Download Manager">

    <!-- Force Modern Dark Fluent Theme -->
    <Grid Background="#121316" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <!-- Custom TitleBar + MenuBar -->
            <RowDefinition Height="36"/>
            <!-- Modern Action Toolbar (FDM + Classic Hybrid) -->
            <RowDefinition Height="56"/>
            <!-- Main Content Area (Sidebar + Table + Bottom Inspector) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar (Snail Mode + Live Speeds) -->
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 1. TOP TITLE & MENU BAR                                  -->
        <!-- ======================================================== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#0D0E11" Padding="12,0" BorderBrush="#22242A" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- App Brand -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                <Border Background="#38BDF8" Width="20" Height="20" CornerRadius="4">
                    <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="#0B0F17" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="SwiftGet" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="#F3F4F6"/>
            </StackPanel>

            <!-- Compact Native MenuBar -->
            <MenuBar Grid.Column="1" VerticalAlignment="Center">
                <MenuBarItem Title="Tasks">
                    <MenuFlyoutItem Text="Add New Download..." Icon="Add" Click="AddDownload_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open Torrent File..." Icon="OpenFile"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Site Grabber Project..." Icon="Globe"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Exit"/>
                </MenuBarItem>
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="Import URLs from Clipboard"/>
                    <MenuFlyoutItem Text="Export Download List"/>
                </MenuBarItem>
                <MenuBarItem Title="Downloads">
                    <MenuFlyoutItem Text="Resume All" Icon="Play"/>
                    <MenuFlyoutItem Text="Stop All" Icon="Stop" Click="StopAll_Click"/>
                    <MenuFlyoutItem Text="Delete All Completed" Icon="Delete" Click="ClearCompleted_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Scheduler &amp; Queues" Icon="Calendar"/>
                    <MenuFlyoutItem Text="Options / Settings" Icon="Setting"/>
                </MenuBarItem>
                <MenuBarItem Title="View">
                    <ToggleMenuFlyoutItem Text="Show Categories Sidebar" IsChecked="True" Click="ToggleSidebar_Click"/>
                    <ToggleMenuFlyoutItem Text="Show Bottom Inspector" IsChecked="True" Click="ToggleInspector_Click"/>
                </MenuBarItem>
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="Check for Updates"/>
                    <MenuFlyoutItem Text="Registration / License"/>
                    <MenuFlyoutItem Text="About SwiftGet"/>
                </MenuBarItem>
            </MenuBar>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2. MODERN FDM-STYLE ACTION BAR                           -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Background="#16181D" Padding="12,0" BorderBrush="#252830" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Toggle & Filters (From Reference 3) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Name="SidebarToggleBtn" IsChecked="True" Click="ToggleSidebar_Click"
                              ToolTipService.ToolTip="Toggle Categories Sidebar"
                              Background="#21242C" BorderBrush="#2E323D" CornerRadius="6" Padding="8,6">
                    <FontIcon Glyph="&#xE700;" FontSize="14"/>
                </ToggleButton>

                <!-- Sort DropDown -->
                <ComboBox SelectedIndex="0" Width="125" Background="#21242C" BorderBrush="#2E323D" CornerRadius="6">
                    <ComboBoxItem Content="Newest"/>
                    <ComboBoxItem Content="Largest Size"/>
                    <ComboBoxItem Content="Status"/>
                    <ComboBoxItem Content="File Name"/>
                </ComboBox>

                <!-- Category Filter DropDown -->
                <ComboBox x:Name="QuickCategoryCombo" SelectedIndex="0" Width="130" Background="#21242C" BorderBrush="#2E323D" CornerRadius="6">
                    <ComboBoxItem Content="All files"/>
                    <ComboBoxItem Content="Video / Media"/>
                    <ComboBoxItem Content="Torrents"/>
                    <ComboBoxItem Content="Compressed"/>
                    <ComboBoxItem Content="Programs"/>
                </ComboBox>
            </StackPanel>

            <!-- Primary Sky-Blue "+ Add download" Pill Button (From Reference 3) -->
            <Button Grid.Column="1" Click="AddDownload_Click"
                    Margin="16,0,12,0" Padding="16,7" CornerRadius="16"
                    Background="#5CC8FF" Foreground="#081018" BorderThickness="0" FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="Add download" FontSize="13"/>
                </StackPanel>
            </Button>

            <!-- Grouped Quick Action Controls (Consolidated from Reference 1 & 2) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <AppBarSeparator/>
                <Button Click="ResumeSelected_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Resume Selected" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="#4ADE80"/>
                        <TextBlock Text="Resume" FontSize="12" Foreground="#D1D5DB"/>
                    </StackPanel>
                </Button>
                <Button Click="PauseSelected_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Stop / Pause Selected" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE769;" FontSize="13" Foreground="#FBBF24"/>
                        <TextBlock Text="Stop" FontSize="12" Foreground="#D1D5DB"/>
                    </StackPanel>
                </Button>
                <Button Click="StopAll_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Stop All Active Downloads" Padding="8,6">
                    <FontIcon Glyph="&#xE71A;" FontSize="13" Foreground="#F87171"/>
                </Button>

                <AppBarSeparator/>

                <Button Click="DeleteSelected_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Delete Selected" Padding="8,6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#9CA3AF"/>
                </Button>
                <Button Click="ClearCompleted_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Clear Completed" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE75C;" FontSize="14" Foreground="#9CA3AF"/>
                        <TextBlock Text="Clear Done" FontSize="12" Foreground="#9CA3AF"/>
                    </StackPanel>
                </Button>

                <AppBarSeparator/>

                <!-- Queue & Scheduler Quick Access -->
                <Button Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Scheduler &amp; Queues" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="#A78BFA"/>
                        <TextBlock Text="Scheduler" FontSize="12" Foreground="#D1D5DB"/>
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Site Grabber" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="#38BDF8"/>
                        <TextBlock Text="Grabber" FontSize="12" Foreground="#D1D5DB"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Modern Search Box (From Reference 3) -->
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="4"
                            PlaceholderText="Search in downloads..."
                            QueryIcon="Find" VerticalAlignment="Center"
                            TextChanged="SearchBox_TextChanged"
                            Background="#21242C" BorderBrush="#2E323D" CornerRadius="16"/>

            <!-- Right Settings / More Menu Button -->
            <Button Grid.Column="5" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" Padding="8">
                <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#9CA3AF"/>
            </Button>
        </Grid>

        <!-- ======================================================== -->
        <!-- 3. MAIN WORKSPACE (SIDEBAR + LIST + DROPZONE + INSPECTOR)-->
        <!-- ======================================================== -->
        <SplitView x:Name="MainSplitView" Grid.Row="2" IsPaneOpen="True" OpenPaneLength="215"
                   DisplayMode="Inline" PaneBackground="#14161B">

            <!-- Left Categories & Queues Tree (From Reference 1 & 2) -->
            <SplitView.Pane>
                <Border BorderBrush="#22252D" BorderThickness="0,0,1,0" Padding="8,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="10,0,0,6"/>

                            <ListView x:Name="CategoryList" SelectionMode="Single" SelectedIndex="0" SelectionChanged="CategoryList_SelectionChanged">
                                <ListViewItem Tag="All">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Width="170">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="#38BDF8" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="All Downloads" FontSize="13"/>
                                        <InfoBadge Grid.Column="2" Value="4" Background="#252832"/>
                                    </Grid>
                                </ListViewItem>
                                <ListViewItem Tag="Video">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Width="170" Margin="12,0,0,0">
                                        <FontIcon Glyph="&#xE714;" FontSize="13" Foreground="#A78BFA" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="Video / Media" FontSize="12.5" Foreground="#D1D5DB"/>
                                    </Grid>
                                </ListViewItem>
                                <ListViewItem Tag="Compressed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Width="170" Margin="12,0,0,0">
                                        <FontIcon Glyph="&#xF012;" FontSize="13" Foreground="#FBBF24" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="Compressed" FontSize="12.5" Foreground="#D1D5DB"/>
                                    </Grid>
                                </ListViewItem>
                                <ListViewItem Tag="Programs">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Width="170" Margin="12,0,0,0">
                                        <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="#60A5FA" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="Programs" FontSize="12.5" Foreground="#D1D5DB"/>
                                    </Grid>
                                </ListViewItem>
                                <ListViewItem Tag="Unfinished">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Width="170">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" Foreground="#FBBF24" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="Unfinished" FontSize="13"/>
                                        <InfoBadge Grid.Column="2" Value="2" Background="#252832"/>
                                    </Grid>
                                </ListViewItem>
                                <ListViewItem Tag="Completed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Width="170">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#4ADE80" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="Finished" FontSize="13"/>
                                        <InfoBadge Grid.Column="2" Value="2" Background="#252832"/>
                                    </Grid>
                                </ListViewItem>
                            </ListView>

                            <Border Height="1" Background="#22252D" Margin="8,10"/>
                            <TextBlock Text="QUEUES &amp; PROJECTS" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="10,0,0,6"/>

                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE90B;" FontSize="14" Foreground="#38BDF8"/>
                                    <TextBlock Text="Main Queue (Q1)" FontSize="12.5" Foreground="#D1D5DB"/>
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="#F472B6"/>
                                    <TextBlock Text="Grabber projects" FontSize="12.5" Foreground="#D1D5DB"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </SplitView.Pane>

            <!-- Right Content Area -->
            <Grid Background="#121316">
                <Grid.RowDefinitions>
                    <!-- Table Header -->
                    <RowDefinition Height="36"/>
                    <!-- Download Items List -->
                    <RowDefinition Height="*"/>
                    <!-- Dashed Drag & Drop Zone (From Reference 3) -->
                    <RowDefinition Height="105"/>
                    <!-- Bottom Detailed Inspector (From Reference 3) -->
                    <RowDefinition x:Name="InspectorRow" Height="225"/>
                </Grid.RowDefinitions>

                <!-- 3A. TABLE COLUMN HEADERS -->
                <Grid Grid.Row="0" Background="#181A20" Padding="16,0" BorderBrush="#23262F" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Name" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Q" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" Text="Size" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="4" Text="Status / Progress" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="5" Text="Download" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="6" Text="Time left" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="7" Text="Added" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>

                <!-- 3B. DOWNLOAD ITEMS LISTVIEW -->
                <ListView x:Name="DownloadsListView" Grid.Row="1"
                          ItemsSource="{x:Bind FilteredDownloads}"
                          SelectionMode="Single"
                          SelectionChanged="DownloadsListView_SelectionChanged"
                          Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DownloadItem">
                            <Grid Padding="4,10" BorderBrush="#1C1F26" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"/>

                                <!-- Icon + File Name -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind IconGlyph}" Foreground="{x:Bind AccentColor}" FontSize="16"/>
                                    <TextBlock Text="{x:Bind FileName}" Foreground="#F3F4F6" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis" MaxWidth="360" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Queue Tag -->
                                <TextBlock Grid.Column="2" Text="{x:Bind QueueName}" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>

                                <!-- Size -->
                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" Foreground="#D1D5DB" FontSize="12.5" VerticalAlignment="Center"/>

                                <!-- Status + Live Progress Bar -->
                                <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Status}" Foreground="{x:Bind StatusColor}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind ProgressPercentage}" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Value="{x:Bind Progress}" Maximum="100" Foreground="{x:Bind AccentColor}" Background="#262934" Height="4" CornerRadius="2"/>
                                </StackPanel>

                                <!-- Transfer Rate -->
                                <TextBlock Grid.Column="5" Text="{x:Bind SpeedText}" Foreground="#38BDF8" FontSize="12.5" VerticalAlignment="Center"/>

                                <!-- Time Left -->
                                <TextBlock Grid.Column="6" Text="{x:Bind EtaText}" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>

                                <!-- Added Date + Context Button -->
                                <Grid Grid.Column="7" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind AddedDate}" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                                    <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4">
                                        <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="#9CA3AF"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 3C. DASHED DRAG-AND-DROP ZONE (From Reference 3) -->
                <Grid Grid.Row="2" Margin="16,8,16,12" AllowDrop="True"
                      DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                    <!-- SVG Dashed Rectangle Border Approximation -->
                    <Border Background="#15181F" BorderBrush="#2E3340" BorderThickness="2" CornerRadius="10"
                            PointerPressed="AddDownload_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="#6B7280"/>
                            <TextBlock Text="Drag-and-drop URL or torrent file here (or click to add)"
                                       Foreground="#6B7280" FontSize="13.5" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3D. BOTTOM INSPECTOR PANEL (GENERAL / DETAILS / PROGRESS / CONNECTIONS) -->
                <Grid x:Name="BottomInspectorPanel" Grid.Row="3" Background="#16181E" BorderBrush="#262934" BorderThickness="0,1,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Inspector Header Tabs + Close Button -->
                    <Grid Grid.Row="0" Background="#1A1D24" Padding="12,0" BorderBrush="#242832" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <RadioButton x:Name="TabGeneral" Content="GENERAL" GroupName="InspectorTabs" IsChecked="True"
                                         Checked="InspectorTab_Checked" Style="{StaticResource DefaultButtonStyle}"
                                         FontSize="11" FontWeight="Bold" Padding="10,4" CornerRadius="4"/>
                            <RadioButton x:Name="TabProgress" Content="PROGRESS &amp; CHUNKS" GroupName="InspectorTabs"
                                         Checked="InspectorTab_Checked" Style="{StaticResource DefaultButtonStyle}"
                                         FontSize="11" FontWeight="Bold" Padding="10,4" CornerRadius="4"/>
                            <RadioButton x:Name="TabConnections" Content="CONNECTIONS" GroupName="InspectorTabs"
                                         Checked="InspectorTab_Checked" Style="{StaticResource DefaultButtonStyle}"
                                         FontSize="11" FontWeight="Bold" Padding="10,4" CornerRadius="4"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" Click="ToggleInspector_Click" Background="Transparent" BorderThickness="0" Padding="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#9CA3AF"/>
                        </Button>
                    </Grid>

                    <!-- GENERAL TAB CONTENT (Matches Reference 3 Bottom Panel) -->
                    <Grid x:Name="GeneralTabView" Grid.Row="1" Padding="18,14" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Media Preview Card -->
                        <Border Grid.Column="0" Background="#0D0F14" BorderBrush="#262934" BorderThickness="1" CornerRadius="8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                <FontIcon Glyph="&#xE714;" FontSize="32" Foreground="#38BDF8"/>
                                <TextBlock Text="1080p Media Preview" FontSize="11" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>

                        <!-- Metadata Details -->
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock x:Name="InspectorTitle"
                                       Text="www.1TamilMV.solar - Jailer 2 (2026) Tamil HQ PreDVD - 1080p - x264 - AAC - 2.9GB.mkv"
                                       FontSize="14.5" FontWeight="SemiBold" Foreground="#F3F4F6" TextTrimming="CharacterEllipsis"/>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="InspectorFolder" Text="D:\Movies" Foreground="#9CA3AF" FontSize="12.5" VerticalAlignment="Center"/>
                                <Button Background="Transparent" BorderThickness="0" Padding="4" ToolTipService.ToolTip="Open Containing Folder">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="12" Foreground="#9CA3AF"/>
                                </Button>
                            </StackPanel>

                            <Grid ColumnDefinitions="240,260,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" Margin="0,4,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12.5" Foreground="#9CA3AF">
                                    Downloaded: <Run x:Name="InspectorDownloaded" Text="3.03 GB" Foreground="#F3F4F6" FontWeight="Medium"/>
                                </TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12.5" Foreground="#9CA3AF">
                                    Uploaded: <Run Text="625 MB (ratio: 0.20)" Foreground="#F3F4F6" FontWeight="Medium"/>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12.5" Foreground="#9CA3AF">
                                    Added at: <Run x:Name="InspectorAdded" Text="Oct 24 2026, 11:01 PM" Foreground="#F3F4F6"/>
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12.5" Foreground="#9CA3AF">
                                    Priority: <Run Text="Normal (Auto-Boost)" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" FontSize="12" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis">
                                    Source: <Hyperlink NavigateUri="https://example.com" Foreground="#38BDF8">magnet:?xt=urn:btih:2c6cbc17e58d06bbbad4beb1021e953...PreDVD-1080p.mkv</Hyperlink>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- PROGRESS & CHUNKS TAB CONTENT (Multi-thread visualizer) -->
                    <StackPanel x:Name="ProgressTabView" Grid.Row="1" Padding="18,14" Spacing="10" Visibility="Collapsed">
                        <TextBlock Text="Multi-Threaded Segment Allocation (32 Active Chunks)" FontSize="12.5" Foreground="#D1D5DB" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="ChunksGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="16"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="Blue = Completed Chunk   |   Cyan = Actively Streaming   |   Dark = Queued" FontSize="11.5" Foreground="#9CA3AF"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </SplitView>

        <!-- ======================================================== -->
        <!-- 4. BOTTOM STATUS BAR (SNAIL MODE + LIVE TELEMETRY)       -->
        <!-- ======================================================== -->
        <Grid Grid.Row="3" Background="#0D0E12" Padding="12,0" BorderBrush="#22242C" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Snail Mode Toggle (From Reference 3) -->
            <ToggleButton x:Name="SnailModeBtn" Grid.Column="0" Padding="8,3" CornerRadius="4"
                          Background="#1E2028" BorderBrush="#2E323E" Margin="0,0,10,0"
                          ToolTipService.ToolTip="Snail Mode (Limit Bandwidth for Gaming/Browsing)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="SNAIL" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                    <FontIcon Glyph="&#xEC4A;" FontSize="12" Foreground="#38BDF8"/>
                </StackPanel>
            </ToggleButton>

            <!-- Live Download / Upload Speeds + Priority Badge -->
